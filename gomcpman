#!/bin/bash

# gomcp 管理脚本
# 使用方法: ./gomcpman.sh [command]
# 命令列表:
#   status      - 查看服务状态
#   logs        - 实时查看日志 (按 Ctrl+C 退出)
#   start       - 启动服务
#   stop        - 停止服务
#   restart     - 重启服务
#   enable      - 启用开机自启
#   disable     - 禁用开机自启
#   install     - 安装服务到用户 systemd
#   uninstall   - 卸载服务
#   help        - 显示帮助信息

SERVICE_NAME="gomcp"
SERVICE_FILE="$(pwd)/${SERVICE_NAME}.service"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 打印带颜色的信息
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# 显示帮助信息
show_help() {
    cat << EOF
gomcp 管理脚本

使用方法:
  $0 [command]

服务管理命令:
  status      查看服务状态
  logs        实时查看日志 (按 Ctrl+C 退出)
  start       启动服务
  stop        停止服务
  restart     重启服务
  enable      启用开机自启
  disable     禁用开机自启
  install     安装服务到用户 systemd
  uninstall   卸载服务

浏览器容器管理命令:
  update-browser   拉取最新镜像（仅在镜像更新时重新创建容器）
  reset-browser    强制重建浏览器容器（无论镜像是否更新）
  browser-status   查看浏览器容器状态
  browser-logs     查看浏览器容器日志 (按 Ctrl+C 退出)

其他命令:
  help        显示此帮助信息

示例:
  $0 status         # 查看当前服务状态
  $0 logs           # 实时查看日志
  $0 restart        # 重启服务
  $0 enable         # 启用开机自启
  $0 update-browser # 更新浏览器容器
  $0 reset-browser  # 强制重建浏览器容器

EOF
}

# 检查服务是否安装
check_service_installed() {
    systemctl --user list-unit-files | grep -q "^${SERVICE_NAME}.service"
    return $?
}

# 查看服务状态
view_status() {
    print_info "查看服务状态..."
    systemctl --user status ${SERVICE_NAME} || print_error "服务未运行或未安装"
}

# 查看日志
view_logs() {
    print_info "实时查看日志 (按 Ctrl+C 退出)..."
    journalctl --user -u ${SERVICE_NAME} -f
}

# 启动服务
start_service() {
    print_info "启动服务..."
    systemctl --user start ${SERVICE_NAME}
    if [ $? -eq 0 ]; then
        print_success "服务启动成功"
    else
        print_error "服务启动失败 (请检查是否已安装: $0 install)"
    fi
}

# 停止服务
stop_service() {
    print_info "停止服务..."
    systemctl --user stop ${SERVICE_NAME}
    if [ $? -eq 0 ]; then
        print_success "服务已停止"
    else
        print_error "服务停止失败 (请检查是否已安装)"
    fi
}

# 重启服务
restart_service() {
    print_info "重启服务..."
    systemctl --user restart ${SERVICE_NAME}
    if [ $? -eq 0 ]; then
        print_success "服务重启成功"
    else
        print_error "服务重启失败 (请检查是否已安装)"
    fi
}

# 启用开机自启
enable_service() {
    print_info "启用开机自启..."
    systemctl --user enable ${SERVICE_NAME}
    if [ $? -eq 0 ]; then
        print_success "已启用开机自启"
    else
        print_error "启用失败 (请检查是否已安装)"
    fi
}

# 禁用开机自启
disable_service() {
    print_info "禁用开机自启..."
    systemctl --user disable ${SERVICE_NAME}
    if [ $? -eq 0 ]; then
        print_success "已禁用开机自启"
    else
        print_error "禁用失败 (请检查是否已安装)"
    fi
}

# 安装服务
install_service() {
    if [ ! -f "$SERVICE_FILE" ]; then
        print_error "服务文件不存在: $SERVICE_FILE"
        return 1
    fi

    # 检查 gomcp 是否已安装
    if [ ! -f "$HOME/go/bin/gomcp" ]; then
        print_error "gomcp 未安装"
        print_info "请先运行以下命令安装 gomcp:"
        echo -e "  ${GREEN}go install github.com/lightpanda-io/gomcp@latest${NC}"
        return 1
    fi

    print_info "安装服务到用户 systemd..."

    # 如果已安装，先卸载
    if check_service_installed; then
        print_warning "服务已安装，将更新软链接..."
        rm -f ~/.config/systemd/user/${SERVICE_NAME}.service
    fi

    mkdir -p ~/.config/systemd/user
    ln -sf "$SERVICE_FILE" ~/.config/systemd/user/${SERVICE_NAME}.service
    systemctl --user daemon-reload

    if check_service_installed; then
        print_success "服务安装成功 (使用软链接: ~/.config/systemd/user/${SERVICE_NAME}.service -> $SERVICE_FILE)"
        print_info "提示: 修改当前目录下的 service 文件后，服务会自动使用最新版本"
        print_info "使用 '$0 enable' 启用开机自启"
        print_info "使用 '$0 start' 立即启动服务"
    else
        print_error "服务安装失败"
        return 1
    fi
}

# 卸载服务
uninstall_service() {
    print_info "卸载服务..."

    # 先停止服务
    systemctl --user stop ${SERVICE_NAME} 2>/dev/null

    # 禁用开机自启
    systemctl --user disable ${SERVICE_NAME} 2>/dev/null

    # 删除服务文件
    rm -f ~/.config/systemd/user/${SERVICE_NAME}.service
    systemctl --user daemon-reload

    print_success "服务已卸载"
}

# 检查 Docker 是否运行
check_docker() {
    if ! command -v docker &> /dev/null; then
        print_error "Docker 未安装或不在 PATH 中"
        return 1
    fi
    if ! docker info &> /dev/null; then
        print_error "Docker 未运行或无权限访问"
        return 1
    fi
    return 0
}

# 更新浏览器容器
update_browser() {
    print_info "开始更新浏览器容器..."

    # 检查 Docker
    if ! check_docker; then
        return 1
    fi

    # 检查容器是否存在
    CONTAINER_EXISTS=false
    CONTAINER_RUNNING=false
    if docker ps -a --format '{{.Names}}' | grep -q "^lightpanda$"; then
        CONTAINER_EXISTS=true
        print_info "发现现有容器 lightpanda"

        # 检查容器是否正在运行
        CONTAINER_STATUS=$(docker ps --filter name=lightpanda --format '{{.Status}}' 2>/dev/null)
        if [ -n "$CONTAINER_STATUS" ]; then
            if echo "$CONTAINER_STATUS" | grep -q "Up"; then
                CONTAINER_RUNNING=true
                print_info "容器正在运行"
            else
                print_warning "容器已停止 (状态: $CONTAINER_STATUS)"
            fi
        else
            print_warning "容器存在但无法获取状态"
        fi
    fi

    # 获取当前镜像的 digest（如果容器存在）
    OLD_DIGEST=""
    if [ "$CONTAINER_EXISTS" = true ]; then
        OLD_DIGEST=$(docker inspect lightpanda --format='{{.Image}}' | cut -d'@' -f2 2>/dev/null)
        if [ -n "$OLD_DIGEST" ]; then
            print_info "当前镜像 digest: ${OLD_DIGEST:0:19}..."
        fi
    fi

    # 如果容器存在但未运行，也需要重新创建
    RECREATE_NEEDED=false
    if [ "$CONTAINER_EXISTS" = true ] && [ "$CONTAINER_RUNNING" = false ]; then
        RECREATE_NEEDED=true
        print_info "检测到容器未运行，需要重新创建"
    fi

    # 拉取最新镜像
    print_info "拉取最新镜像: lightpanda/browser:latest"
    if ! docker pull lightpanda/browser:latest; then
        print_error "镜像拉取失败"
        return 1
    fi

    # 获取新镜像的 digest
    NEW_DIGEST=$(docker inspect lightpanda/browser:latest --format='{{.Id}}' 2>/dev/null)
    if [ -z "$NEW_DIGEST" ]; then
        print_error "无法获取新镜像 digest"
        return 1
    fi
    print_info "新镜像 digest: ${NEW_DIGEST:0:19}..."

    # 比较镜像 digest 或检查是否需要重新创建
    if [ "$OLD_DIGEST" = "$NEW_DIGEST" ] && [ "$RECREATE_NEEDED" = false ]; then
        print_success "镜像已是最新版本且容器运行正常，无需更新容器"
        return 0
    fi

    if [ "$RECREATE_NEEDED" = true ]; then
        print_info "检测到容器未运行，准备重新创建容器..."
    else
        print_info "检测到镜像更新，准备重新创建容器..."
    fi

    # 删除旧容器（如果存在）
    if [ "$CONTAINER_EXISTS" = true ]; then
        print_warning "删除旧容器 lightpanda..."
        if ! docker rm lightpanda --force; then
            print_error "删除容器失败"
            return 1
        fi
    fi

    # 计算资源限制（系统资源的50%）
    print_info "计算资源限制（50%系统资源）..."

    # 获取系统总内存（单位：字节）
    TOTAL_MEM=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    # 计算50%内存限制（单位：字节）
    MEM_LIMIT=$((TOTAL_MEM * 50 / 100))
    # 转换为人类可读格式（MB）
    MEM_LIMIT_MB=$((MEM_LIMIT / 1024))

    # 获取CPU核心数
    CPU_COUNT=$(nproc)
    # 计算50% CPU限制
    CPU_LIMIT=$((CPU_COUNT * 50 / 100))
    # 确保至少分配0.5个CPU
    if [ $CPU_LIMIT -eq 0 ]; then
        CPU_LIMIT=0.5
    fi

    print_info "系统总内存: $((TOTAL_MEM / 1024)) MB"
    print_info "内存限制: ${MEM_LIMIT_MB} MB (50%)"
    print_info "CPU核心数: $CPU_COUNT"
    print_info "CPU限制: $CPU_LIMIT (50%)"

    # 创建新容器（带资源限制）
    print_info "创建新容器..."
    if ! docker run -d \
        --name lightpanda \
        -p 9222:9222 \
        --privileged \
        --memory="${MEM_LIMIT_MB}m" \
        --memory-swap="${MEM_LIMIT_MB}m" \
        --cpus="$CPU_LIMIT" \
        --pids-limit=1000 \
        lightpanda/browser:latest; then
        print_error "创建容器失败"
        return 1
    fi

    print_success "浏览器容器更新完成！"
    print_info "容器运行在端口 9222"
    print_info "内存限制: ${MEM_LIMIT_MB} MB"
    print_info "CPU限制: $CPU_LIMIT 核心"
    print_info "进程数限制: 1000"
    print_info "使用 'docker ps' 查看容器状态"
}

# 强制重建浏览器容器
reset_browser() {
    print_info "开始强制重建浏览器容器..."

    # 检查 Docker
    if ! check_docker; then
        return 1
    fi

    # 检查容器是否存在，存在则删除
    if docker ps -a --format '{{.Names}}' | grep -q "^lightpanda$"; then
        print_warning "删除现有容器 lightpanda..."
        if ! docker rm lightpanda --force; then
            print_error "删除容器失败"
            return 1
        fi
        print_success "旧容器已删除"
    fi

    # 拉取最新镜像
    print_info "拉取最新镜像: lightpanda/browser:latest"
    if ! docker pull lightpanda/browser:latest; then
        print_error "镜像拉取失败"
        return 1
    fi

    # 计算资源限制（系统资源的50%）
    print_info "计算资源限制（50%系统资源）..."

    # 获取系统总内存（单位：字节）
    TOTAL_MEM=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    # 计算50%内存限制（单位：字节）
    MEM_LIMIT=$((TOTAL_MEM * 50 / 100))
    # 转换为人类可读格式（MB）
    MEM_LIMIT_MB=$((MEM_LIMIT / 1024))

    # 获取CPU核心数
    CPU_COUNT=$(nproc)
    # 计算50% CPU限制
    CPU_LIMIT=$((CPU_COUNT * 50 / 100))
    # 确保至少分配0.5个CPU
    if [ "$CPU_LIMIT" -eq 0 ]; then
        CPU_LIMIT=0.5
    fi

    print_info "系统总内存: $((TOTAL_MEM / 1024)) MB"
    print_info "内存限制: ${MEM_LIMIT_MB} MB (50%)"
    print_info "CPU核心数: $CPU_COUNT"
    print_info "CPU限制: $CPU_LIMIT (50%)"

    # 创建新容器（带资源限制）
    print_info "创建新容器..."
    if ! docker run -d \
        --name lightpanda \
        -p 9222:9222 \
        --privileged \
        --memory="${MEM_LIMIT_MB}m" \
        --memory-swap="${MEM_LIMIT_MB}m" \
        --cpus="$CPU_LIMIT" \
        --pids-limit=1000 \
        lightpanda/browser:latest; then
        print_error "创建容器失败"
        return 1
    fi

    print_success "浏览器容器重建完成！"
    print_info "容器运行在端口 9222"
    print_info "内存限制: ${MEM_LIMIT_MB} MB"
    print_info "CPU限制: $CPU_LIMIT 核心"
    print_info "进程数限制: 1000"
    print_info "使用 'docker ps' 查看容器状态"
}

# 查看浏览器容器状态
browser_status() {
    print_info "查看浏览器容器状态..."

    if ! check_docker; then
        return 1
    fi

    if docker ps -a --format '{{.Names}}' | grep -q "^lightpanda$"; then
        print_success "浏览器容器存在"
        docker ps --filter name=lightpanda --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
    else
        print_warning "浏览器容器不存在"
        print_info "运行 '$0 update-browser' 来创建容器"
    fi
}

# 查看浏览器容器日志
browser_logs() {
    print_info "查看浏览器容器日志 (按 Ctrl+C 退出)..."
    if ! check_docker; then
        return 1
    fi
    docker logs -f lightpanda 2>&1
}

# 主逻辑
case "$1" in
    status)
        view_status
        ;;
    logs)
        view_logs
        ;;
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        restart_service
        ;;
    enable)
        enable_service
        ;;
    disable)
        disable_service
        ;;
    install)
        install_service
        ;;
    uninstall)
        uninstall_service
        ;;
    update-browser)
        update_browser
        ;;
    reset-browser)
        reset_browser
        ;;
    browser-status)
        browser_status
        ;;
    browser-logs)
        browser_logs
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        print_error "请指定命令"
        echo
        show_help
        exit 1
        ;;
    *)
        print_error "未知命令: $1"
        echo
        show_help
        exit 1
        ;;
esac
